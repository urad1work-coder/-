{
  "manifest_version": 3,
  "name": "NowPlaying Helper",
  "version": "1.1.0",
  "description": "偵測 YouTube / YouTube Music 播放資訊，傳給 NowPlaying 直播插件",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "http://127.0.0.1:3456/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "NowPlaying Helper"
  }
}
